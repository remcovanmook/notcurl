#!/bin/sh
# 2026 Remco van Mook @rvmnl - Apache-2.0 - github.com/remcovanmook/notcurl
#
# Builds the polyglot files in portable/ out of the bash and powershell sets.
# Nothing is rewritten on the way through: each source contributes either its
# marked "# >>> hget / # <<< hget" function block, or the whole file.
#
# The layout of a generated file:
#
#   function choose { ... }     parses as PowerShell, only ever runs under sh
#   ${true:-choose "$@"}        sh: calls choose.  pwsh: $null, emits nothing
#   <# ... #>                   sh has exited; PowerShell reads a block comment
#     the shell program           - plain, unprefixed, extracted by choose
#   PowerShell definitions      sh never parses this far
#   & "choose$true" @args       pwsh entry point
set -e
cd "${0%/*}/.."
A='# 2026 Remco van Mook @rvmnl - Apache-2.0 - github.com/remcovanmook/notcurl'

block()   { sed -n '/^# >>> hget$/,/^# <<< hget$/p' "$1"; }   # the marked function
body()    { tail -n +2 "$1"; }                                # whole file, no shebang
head_()   {
    printf '#!/bin/bash\n%s\n# %s\n#\n' "$A" "$2"
    printf '# Built by "make portable" from %s. Do not edit here.\n#\n' "$3"
    printf '#   ./%s ARGS   (Unix: the shebang wins, the extension is ignored)\n' "$1"
    printf '#   .\\%s ARGS   (Windows PowerShell)\n\n' "$1"
    printf 'function choose\n{\neval "$(sed -n '"'"'/^# SHELL$/,/^# ENDSHELL$/p'"'"' "$0")"\nexit\n}\n'
    printf '${true:-choose "$@"}\n\n<#\n# SHELL\n'
}
shell_end() { printf '# ENDSHELL\n#>\n\n'; }

# ---- hget ---------------------------------------------------------------
{
    head_ hget.ps1 'hget - fetch a url to stdout' 'bash/hget and powershell/hget.ps1'
    block bash/hget
    printf '\nhget "$@"\n'
    shell_end
    block powershell/hget.ps1
    printf '\nfunction choosetrue\n{\nInvoke-Hget @args\n}\n& "choose$true" @args\n'
} > portable/hget.ps1

# ---- hexec: the same hget function, called in-process --------------------
{
    head_ hexec.ps1 'hexec - fetch, verify against a sha256, then run' \
          'bash/hget, bash/hexec, powershell/hget.ps1 and powershell/hexec.ps1'
    block bash/hget
    printf '\n'
    body bash/hexec
    shell_end
    block powershell/hget.ps1
    printf '\nfunction choosetrue\n{\n'
    body powershell/hexec.ps1
    printf '\n}\n& "choose$true" @args\n'
} > portable/hexec.ps1

chmod +x portable/hget.ps1 portable/hexec.ps1
for f in portable/hget.ps1 portable/hexec.ps1; do
    printf '%s: %s lines, %s bytes\n' "$f" \
        "$(wc -l < "$f" | tr -d ' ')" "$(wc -c < "$f" | tr -d ' ')"
done
