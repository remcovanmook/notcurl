#!/bin/sh
# 2026 Remco van Mook @rvmnl - Apache-2.0 - github.com/remcovanmook/notcurl
#
# Generates the polyglot files in portable/ from the bash and powershell sets.
# Run it as "make portable". Nothing here is hand-maintained.
#
# Layout of a generated file:
#   function choose { ... }     parses as PowerShell, only ever runs under sh
#   #: shell implementation     PowerShell sees comments; sh evals them back
#   #= embedded shell hget      likewise, for the tools that need to fetch
#   ${true:-choose "$@"}        sh: calls choose.  pwsh: $null, emits nothing
#   function choosetrue { ... } sh never parses this; it exited at the dispatch
#   & "choose$true" @args       pwsh calls it
set -e
cd "${0%/*}/.."
AUTHOR='# 2026 Remco van Mook @rvmnl - Apache-2.0 - github.com/remcovanmook/notcurl'

head() {   # $1 = tool name, $2 = one-line description
    printf '#!/bin/bash\n%s\n# %s\n#\n' "$AUTHOR" "$2"
    printf '# Generated by "make portable" - edit bash/%s or powershell/%s.ps1,\n' "$1" "$1"
    printf '# not this file. See portable/README.md.\n#\n'
    printf '#   ./%s.ps1 ARGS   (Unix: the shebang wins, the extension is ignored)\n' "$1"
    printf '#   .\\%s.ps1 ARGS   (Windows PowerShell)\n\n' "$1"
    printf 'function choose\n{\neval "$(sed -n '"'"'s/^#://p'"'"' "$0")"\nexit\n}\n'
}
dispatch() { printf '${true:-choose "$@"}\nfunction choosetrue\n{\n'; }
tail_()    { printf '\n}\n& "choose$true" @args\n'; }

# ---- hget: shell half and pwsh half go in whole ------------------------
{
    head hget "hget - fetch a url to stdout"
    tail -n +2 bash/hget | sed 's/^/#:/'
    printf '#:exit\n'
    dispatch
    tail -n +2 powershell/hget.ps1
    tail_
} > portable/hget.ps1

# ---- hexec: hget is embedded, not invoked as a separate program --------
#
# sh side: bash/hget rides along verbatim under "#=" and is eval'd inside a
# subshell, so its own say/die/parse definitions and its "exit" stay contained.
# bash/hexec calls "$hget" already, so defining a *function* named hget and
# setting hget=hget leaves every call site untouched - only the two lines that
# located the sibling script are replaced.
{
    head hexec "hexec - fetch, verify against a sha256, then run"
    awk '
        /^hget=\$\{0%\/\*\}\/hget$/ {
            print "hget() { ( eval \"$(sed -n '\''s/^#=//p'\'' \"$0\")\" ) ; }"
            print "hget=hget"
            drop = 1; next
        }
        drop && /^\[ -x "\$hget" \]/ { drop = 0; next }
        { print }
    ' bash/hexec | tail -n +2 | sed 's/^/#:/'
    tail -n +2 bash/hget | sed 's/^/#=/'
    dispatch
    # pwsh side: hget.ps1 becomes a function, and Fetch writes into a file
    # stream instead of spawning a process. hexec's param() block has to stay
    # the first statement, so the insert goes directly after it.
    awk 'NR>1 {print} /^\)$/ {exit}' powershell/hexec.ps1
    printf '\nfunction Invoke-Hget {\n'
    tail -n +2 powershell/hget.ps1
    printf '\n}\n'
    printf 'function Fetch($url, $out) {\n'
    printf '    $fs = [System.IO.File]::Create($out)\n'
    printf '    try { $script:HgetOut = $fs; Invoke-Hget $url }\n'
    printf '    finally { $script:HgetOut = $null; $fs.Close() }\n'
    printf '    return 0\n}\n'
    awk 'p {print} /^\)$/ {p=1}' powershell/hexec.ps1 |
        sed -e '/^\$hget = Join-Path/d' \
            -e '/^if (-not (Test-Path \$hget))/d' \
            -e '/^function Fetch/,/^}/d'
    tail_
} > portable/hexec.ps1

chmod +x portable/hget.ps1 portable/hexec.ps1
for f in portable/hget.ps1 portable/hexec.ps1; do
    printf '%s: %s bytes\n' "$f" "$(wc -c < "$f" | tr -d ' ')"
done
