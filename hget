#!/usr/bin/env bash
USAGE='hget - fetch a URL over HTTP/HTTPS using nothing but bash. No curl, no wget.

usage: hget [-L] [-v] [-o file] <url>
  -L        follow up to 5 redirects
  -v        response headers and TLS errors to stderr
  -o file   write body to file instead of stdout ("-" is stdout)

Scheme defaults to http. Non-2xx exits 1. HTTPS needs openssl(1). bash 3.2+.'

set -u
follow=0 verbose=0 out=- hop=0
say()   { printf 'hget: %s\n' "$*" >&2; }
die()   { say "$@"; exit 1; }
usage() { printf '%s\n' "$USAGE" >&2; exit 2; }
# HTTP/1.0 on purpose: it forbids chunked encoding, so the body needs no framing.
req()   { printf 'GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: hget\r\nAccept: */*\r\n\r\n' "$path" "$hostport"; }

while getopts ':Lvo:' o; do
    case $o in L) follow=1 ;; v) verbose=1 ;; o) out=$OPTARG ;; *) usage ;; esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
url=$1

while :; do
    rest=${url#*://} scheme=http
    [ "$rest" != "$url" ] && scheme=${url%%://*}
    hostport=${rest%%/*} path=/
    [ "${rest#*/}" != "$rest" ] && path=/${rest#*/}
    host=${hostport%%:*} port=${hostport##*:}
    [ "$port" = "$hostport" ] && port=
    [ "$scheme" = http ]  && : "${port:=80}"
    [ "$scheme" = https ] && : "${port:=443}"
    [ -n "$port" ] || die "unsupported scheme: $scheme"
    [ -n "$host" ] || die "no host in url: $url"
    [ "$scheme" = https ] && { ssl=$(command -v openssl); [ -x "${ssl:-}" ] || die "https needs openssl(1)"; }

    if [ "$scheme" = http ]; then
        exec 5<>"/dev/tcp/$host/$port" || die "cannot connect to $host:$port"
        req >&5
    else
        # -quiet implies -ign_eof, so openssl waits for the server to close.
        [ $verbose -eq 1 ] && tls=/dev/stderr || tls=/dev/null
        exec 5< <(req | "$ssl" s_client -quiet -verify_return_error \
                      -servername "$host" -connect "$host:$port" 2>"$tls")
    fi

    read -r proto code reason <&5 && [ -n "$code" ] || die "no usable response from $host:$port (try -v)"
    reason=${reason%$'\r'} loc=
    [ $verbose -eq 1 ] && say "$proto $code $reason"
    shopt -s nocasematch
    while IFS= read -r h <&5 && h=${h%$'\r'} && [ -n "$h" ]; do
        [ $verbose -eq 1 ] && printf '%s\n' "$h" >&2
        [[ $h == location:* ]] && read -r loc <<<"${h#*:}"
    done
    shopt -u nocasematch

    [ $follow -eq 1 ] && [ -n "$loc" ] && [[ $code == 30[12378] ]] || break
    [ $((hop += 1)) -le 5 ] || die "more than 5 redirects"
    case $loc in
        *://*) url=$loc ;;
        /*)    url=$scheme://$hostport$loc ;;
        *)     url=$scheme://$hostport${path%/*}/$loc ;;
    esac
    [ $verbose -eq 1 ] && say "-> $url"
    exec 5<&-
done

[[ $code == 2* ]] || die "$url returned $code $reason"
[ "$out" = - ] && out=/dev/stdout
# read(1) consumed exactly the headers; the rest of fd 5 is the body, byte for byte.
cat <&5 >"$out" || die "cannot write $out"
