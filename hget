#!/usr/bin/env bash
USAGE='hget - fetch a URL over HTTP/HTTPS using nothing but bash. No curl, no wget.

usage: hget <url> [file]        write to file, or to stdout if omitted
       hget [file] <url>        either order; the http:// one is the url

Scheme defaults to http. Redirects are followed. Non-2xx exits 1.
HTTPS needs openssl(1). Runs on bash 3.2 and up.'

set -u
hop=0
say()   { printf 'hget: %s\n' "$*" >&2; }
die()   { say "$@"; exit 1; }
usage() { printf '%s\n' "$USAGE" >&2; exit 2; }
# HTTP/1.0 on purpose: it forbids chunked encoding, so the body needs no framing.
req()   { printf 'GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: hget\r\nAccept: */*\r\n\r\n' "$path" "$hostport"; }

[ $# -ge 1 ] && [ $# -le 2 ] || usage
url=$1 out=${2:-/dev/stdout}
case $out in http://*|https://*) url=$out out=$1 ;; esac

err=
trap '[ -n "$err" ] && rm -f "$err"' EXIT INT TERM

while :; do
    rest=${url#*://} scheme=http
    [ "$rest" != "$url" ] && scheme=${url%%://*}
    hostport=${rest%%/*} path=/
    [ "${rest#*/}" != "$rest" ] && path=/${rest#*/}
    host=${hostport%%:*} port=${hostport##*:}
    [ "$port" = "$hostport" ] && port=
    [ "$scheme" = http ]  && : "${port:=80}"
    [ "$scheme" = https ] && : "${port:=443}"
    [ -n "$port" ] || die "unsupported scheme: $scheme"
    [ -n "$host" ] || die "no host in url: $url"

    if [ "$scheme" = http ]; then
        exec 5<>"/dev/tcp/$host/$port" || die "cannot connect to $host:$port"
        req >&5
    else
        ssl=$(command -v openssl); [ -x "${ssl:-}" ] || die "https needs openssl(1)"
        err=${err:-$(mktemp "${TMPDIR:-/tmp}/hget.XXXXXX")} || die "cannot create temp file"
        # -quiet implies -ign_eof, so openssl waits for the server to close.
        # Its stderr is chatter on success and the only clue on failure, so it
        # is held aside and shown from there.
        exec 5< <(req | "$ssl" s_client -quiet -verify_return_error \
                      -servername "$host" -connect "$host:$port" 2>"$err")
    fi

    read -r proto code reason <&5 && [ -n "$code" ] ||
        { grep -E 'verify error|:error:' "${err:-/dev/null}" >&2
          die "no usable response from $host:$port"; }
    reason=${reason%$'\r'} loc=
    shopt -s nocasematch
    while IFS= read -r h <&5 && h=${h%$'\r'} && [ -n "$h" ]; do
        [[ $h == location:* ]] && read -r loc <<<"${h#*:}"
    done
    shopt -u nocasematch

    [ -n "$loc" ] && [[ $code == 30[12378] ]] || break
    [ $((hop += 1)) -le 5 ] || die "more than 5 redirects"
    case $loc in
        *://*) url=$loc ;;
        /*)    url=$scheme://$hostport$loc ;;
        *)     url=$scheme://$hostport${path%/*}/$loc ;;
    esac
    exec 5<&-
done

[[ $code == 2* ]] || die "$url returned $code $reason"
# read(1) consumed exactly the headers; the rest of fd 5 is the body, byte for byte.
cat <&5 >"$out" || die "cannot write $out"
