#!/bin/sh
USAGE='usage: hwait <url> [timeout]

Polls until the url answers 2xx, then exits 0. Default timeout 60 seconds.'

say() { printf 'hwait: %s\n' "$*" >&2; }
die() { say "$@"; exit 1; }

[ $# -ge 1 ] && [ $# -le 2 ] || { printf '%s\n' "$USAGE" >&2; exit 2; }
url=$1 timeout=${2:-60}
case $timeout in ''|*[!0-9]*) die "timeout must be a whole number of seconds: $timeout" ;; esac

hget=${0%/*}/hget
[ -x "$hget" ] || hget=$(command -v hget) || die "cannot find hget(1)"

deadline=$(( $(date +%s) + timeout ))
while :; do
    "$hget" "$url" >/dev/null 2>&1 && exit 0
    [ "$(date +%s)" -lt "$deadline" ] || die "gave up on $url after ${timeout}s"
    sleep 1
done
